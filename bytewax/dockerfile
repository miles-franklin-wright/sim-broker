FROM python:3.12-slim

WORKDIR /app

# Copy in your flow definitions and pyproject/requirements
COPY . .

# Install Bytewax with Kafka, Kafka client, and Parquet/file-system dependencies
RUN pip install --no-cache-dir \
    bytewax[kafka] \
    kafka-python \
    pyarrow \
    fsspec

# Use the Bytewax runner entrypoint
ENTRYPOINT ["python", "-m", "bytewax.run"]

# Default to the Bronze flow; docker-compose will override CMD for each service
CMD ["flows.heartbeat_flow:build_flow"]
